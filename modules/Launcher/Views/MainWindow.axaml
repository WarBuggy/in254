<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Launcher.ViewModels"
        xmlns:controls="using:Launcher.Controls"
        x:Class="Launcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="in254 Mod Launcher"
        Width="960" Height="720"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="avares://Launcher/Assets/Icon.ico"
        Background="#1A1A2E">

    <Window.Styles>
        <!-- Accent button class -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="20,8" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A8FE0" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#006ABD" />
        </Style>

        <!-- Secondary button class -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#2A2A40" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderBrush" Value="#3A3A55" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#363655" />
        </Style>

        <!-- Toolbar icon button -->
        <Style Selector="Button.toolBtn">
            <Setter Property="Background" Value="#2A2A40" />
            <Setter Property="Foreground" Value="#BBBBBB" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#3A3A55" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="36" />
        </Style>
        <Style Selector="Button.toolBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#363655" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Remove button (per item) -->
        <Style Selector="Button.removeBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Opacity" Value="0.3" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.removeBtn:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.removeBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A1A1A" />
        </Style>

        <!-- Tab styling -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
        </Style>

        <!-- Stat card -->
        <Style Selector="Border.statCard">
            <Setter Property="Background" Value="#22223A" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="BorderBrush" Value="#2E2E48" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Detail card -->
        <Style Selector="Border.detailCard">
            <Setter Property="Background" Value="#22223A" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderBrush" Value="#2E2E48" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Muted label -->
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#888899" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Detail field label -->
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="Foreground" Value="#7788AA" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1" />
        </Style>

        <!-- Detail field value -->
        <Style Selector="TextBlock.fieldValue">
            <Setter Property="Foreground" Value="#DDDDEE" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- Section heading -->
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#EEEEFF" />
        </Style>

        <!-- ListBox item base style (shared) -->
        <Style Selector="ListBox.modList ListBoxItem">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ListBox.modList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#28284A" />
        </Style>
        <Style Selector="ListBox.modList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#24243E" />
        </Style>
        <Style Selector="ListBox.modList ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2A4A" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- ===== HEADER ===== -->
        <Border DockPanel.Dock="Top"
                Background="#16162B"
                Padding="20,14"
                BorderBrush="#2A2A44"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="avares://Launcher/Assets/Icon.ico"
                       Width="28" Height="28"
                       VerticalAlignment="Center" />
                <TextBlock Text="in254"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#0078D4" />
                <TextBlock Text="Mod Launcher"
                           FontSize="20" FontWeight="Light"
                           Foreground="#AAAACC"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ===== FOOTER ===== -->
        <Border DockPanel.Dock="Bottom"
                Background="#16162B"
                Padding="20,12"
                BorderBrush="#2A2A44"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <Button Content="{Binding LaunchButtonText}"
                        Classes="accent"
                        Command="{Binding LaunchGameCommand}" />
                <StackPanel Orientation="Horizontal"
                            Spacing="16"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Classes="muted">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} mods">
                                <Binding Path="TotalModCount" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Foreground="#50C878" FontSize="12">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} enabled">
                                <Binding Path="EnabledModCount" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Foreground="#FF6B6B" FontSize="12">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} disabled">
                                <Binding Path="DisabledModCount" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== BODY ===== -->
        <TabControl Margin="0" Padding="16,8,16,16">

            <!-- ===== OVERVIEW TAB ===== -->
            <TabItem Header="Overview">
                <ScrollViewer Margin="0,12,0,0">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Dashboard" Classes="sectionTitle" />

                        <UniformGrid Columns="3" Margin="0,4,0,0">
                            <Border Classes="statCard" Margin="0,0,8,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Total Mods" Classes="muted" />
                                    <TextBlock Text="{Binding TotalModCount}"
                                               FontSize="28" FontWeight="Bold"
                                               Foreground="#0078D4" />
                                </StackPanel>
                            </Border>
                            <Border Classes="statCard" Margin="4,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Enabled" Classes="muted" />
                                    <TextBlock Text="{Binding EnabledModCount}"
                                               FontSize="28" FontWeight="Bold"
                                               Foreground="#50C878" />
                                </StackPanel>
                            </Border>
                            <Border Classes="statCard" Margin="8,0,0,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Disabled" Classes="muted" />
                                    <TextBlock Text="{Binding DisabledModCount}"
                                               FontSize="28" FontWeight="Bold"
                                               Foreground="#FF6B6B" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== MODS TAB ===== -->
            <TabItem Header="Mods">
                <Grid RowDefinitions="*,Auto" Margin="0,12,0,0">

                    <!-- Top: Two lists side by side -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,12,*,Auto">

                        <!-- ===== LEFT: All Mods ===== -->
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="All Mods"
                                       Classes="sectionTitle"
                                       Margin="0,0,0,8" />
                            <Border CornerRadius="8"
                                    Background="#1E1E36"
                                    BorderBrush="#2E2E48"
                                    BorderThickness="1"
                                    ClipToBounds="True">
                                <ListBox Classes="modList"
                                         ItemsSource="{Binding Mods}"
                                         SelectedItem="{Binding SelectedMod}"
                                         SelectionMode="Toggle"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ModEntryViewModel">
                                            <DockPanel>
                                                <!-- Source badge (right) -->
                                                <Border DockPanel.Dock="Right"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Background="#2A2A40"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Source}"
                                                               FontSize="10"
                                                               Foreground="#888899" />
                                                </Border>

                                                <!-- Thumbnail (left) -->
                                                <Border DockPanel.Dock="Left"
                                                        Width="40" Height="40"
                                                        CornerRadius="4"
                                                        ClipToBounds="True"
                                                        Background="#2A2A40"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,10,0">
                                                    <Panel>
                                                        <Image Source="{Binding Thumbnail}"
                                                               Stretch="UniformToFill"
                                                               IsVisible="{Binding HasThumbnail}" />
                                                        <TextBlock Text="&#x2B22;"
                                                                   FontSize="18"
                                                                   Foreground="#555570"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="{Binding !HasThumbnail}" />
                                                    </Panel>
                                                </Border>

                                                <!-- Checkbox + name -->
                                                <CheckBox IsChecked="{Binding IsEnabled}"
                                                          IsEnabled="{Binding !IsReserved}"
                                                          VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               Foreground="#DDDDEE"
                                                               VerticalAlignment="Center" />
                                                </CheckBox>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </DockPanel>

                        <!-- ===== RIGHT: Load Order ===== -->
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Load Order"
                                       Classes="sectionTitle"
                                       Margin="0,0,0,8" />
                            <Border CornerRadius="8"
                                    Background="#1E1E36"
                                    BorderBrush="#2E2E48"
                                    BorderThickness="1"
                                    ClipToBounds="True">
                                <controls:DragReorderListBox
                                         Classes="modList"
                                         ItemsSource="{Binding EnabledMods}"
                                         SelectedItem="{Binding SelectedEnabledMod}"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <controls:DragReorderListBox.Styles>
                                        <Style Selector="ListBoxItem.dragSource">
                                            <Setter Property="Opacity" Value="0.4" />
                                        </Style>
                                        <Style Selector="ListBoxItem Border[Tag=GripHandle]:pointerover">
                                            <Setter Property="Background" Value="#2A2A4A" />
                                        </Style>
                                        <Style Selector="ListBoxItem Border[Tag=GripHandle]:pointerover Ellipse">
                                            <Setter Property="Fill" Value="#8888AA" />
                                        </Style>
                                    </controls:DragReorderListBox.Styles>

                                    <controls:DragReorderListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ModEntryViewModel">
                                            <Panel>
                                                <Border x:Name="DropIndicator"
                                                        Height="2"
                                                        Background="#0078D4"
                                                        VerticalAlignment="Top"
                                                        Margin="-10,-8"
                                                        IsVisible="False" />
                                                <DockPanel>
                                                    <!-- Grip handle (left) -->
                                                    <Border Tag="GripHandle"
                                                            DockPanel.Dock="Left"
                                                            Cursor="Hand"
                                                            Margin="0,0,8,0"
                                                            Padding="3,2"
                                                            CornerRadius="4"
                                                            Background="Transparent"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding !IsReserved}">
                                                        <Grid RowDefinitions="Auto,Auto,Auto"
                                                              ColumnDefinitions="Auto,Auto"
                                                              Tag="GripHandle">
                                                            <Ellipse Grid.Row="0" Grid.Column="0" Width="3" Height="3" Fill="#555570" Margin="1" />
                                                            <Ellipse Grid.Row="0" Grid.Column="1" Width="3" Height="3" Fill="#555570" Margin="1" />
                                                            <Ellipse Grid.Row="1" Grid.Column="0" Width="3" Height="3" Fill="#555570" Margin="1" />
                                                            <Ellipse Grid.Row="1" Grid.Column="1" Width="3" Height="3" Fill="#555570" Margin="1" />
                                                            <Ellipse Grid.Row="2" Grid.Column="0" Width="3" Height="3" Fill="#555570" Margin="1" />
                                                            <Ellipse Grid.Row="2" Grid.Column="1" Width="3" Height="3" Fill="#555570" Margin="1" />
                                                        </Grid>
                                                    </Border>
                                                    <!-- Spacer for reserved mods (no grip) -->
                                                    <Border DockPanel.Dock="Left"
                                                            Width="18"
                                                            IsVisible="{Binding IsReserved}" />

                                                    <!-- Remove from order (right) -->
                                                    <Button Classes="removeBtn"
                                                            DockPanel.Dock="Right"
                                                            Command="{Binding DisableCommand}"
                                                            ToolTip.Tip="Remove from load order"
                                                            IsVisible="{Binding !IsReserved}"
                                                            VerticalAlignment="Center"
                                                            Margin="4,0,0,0">
                                                        <TextBlock Text="&#x2715;" FontSize="11" Foreground="#FF6B6B" />
                                                    </Button>

                                                    <!-- Thumbnail -->
                                                    <Border DockPanel.Dock="Left"
                                                            Width="32" Height="32"
                                                            CornerRadius="4"
                                                            ClipToBounds="True"
                                                            Background="#2A2A40"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0">
                                                        <Panel>
                                                            <Image Source="{Binding Thumbnail}"
                                                                   Stretch="UniformToFill"
                                                                   IsVisible="{Binding HasThumbnail}" />
                                                            <TextBlock Text="&#x2B22;"
                                                                       FontSize="16"
                                                                       Foreground="#555570"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding !HasThumbnail}" />
                                                        </Panel>
                                                    </Border>

                                                    <!-- Name -->
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="12"
                                                               Foreground="#DDDDEE"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Panel>
                                        </DataTemplate>
                                    </controls:DragReorderListBox.ItemTemplate>
                                </controls:DragReorderListBox>
                            </Border>
                        </DockPanel>

                        <!-- Reorder buttons (far right) -->
                        <StackPanel Grid.Column="3"
                                    Spacing="6"
                                    Margin="8,26,0,0"
                                    VerticalAlignment="Top">
                            <Button Classes="toolBtn"
                                    Command="{Binding MoveUpCommand}"
                                    ToolTip.Tip="Move Up">
                                <TextBlock Text="&#x25B2;" FontSize="11" />
                            </Button>
                            <Button Classes="toolBtn"
                                    Command="{Binding MoveDownCommand}"
                                    ToolTip.Tip="Move Down">
                                <TextBlock Text="&#x25BC;" FontSize="11" />
                            </Button>
                            <Border Height="1" Background="#3A3A55" Margin="0,2" />
                            <Button Classes="toolBtn"
                                    Command="{Binding AutoReOrderCommand}"
                                    ToolTip.Tip="Auto sort mods">
                                <TextBlock Text="&#x21C5;" FontSize="13" />
                            </Button>
                            <Button Classes="toolBtn"
                                    Command="{Binding AddModCommand}"
                                    ToolTip.Tip="Add mod">
                                <TextBlock Text="+" FontSize="14" FontWeight="Bold" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Detail panel (bottom) -->
                    <Border Grid.Row="1"
                            Classes="detailCard"
                            Margin="0,10,0,0"
                            IsVisible="{Binding IsDetailVisible}">
                        <StackPanel Spacing="10" DataContext="{Binding SelectedMod}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left"
                                        Width="48" Height="48"
                                        CornerRadius="6"
                                        ClipToBounds="True"
                                        Background="#2A2A40"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0">
                                    <Panel>
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding HasThumbnail}" />
                                        <TextBlock Text="&#x2B22;"
                                                   FontSize="24"
                                                   Foreground="#555570"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding !HasThumbnail}" />
                                    </Panel>
                                </Border>
                                <TextBlock Text="Mod Details" Classes="sectionTitle"
                                           VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"
                                        Background="#2A2A40"
                                        BorderBrush="#3A3A55"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        Cursor="Hand"
                                        ToolTip.Tip="View full mod details"
                                        Click="OnShowModDetail">
                                    <TextBlock Text="&#x2139;" FontSize="14" Foreground="#8899BB" />
                                </Button>
                            </DockPanel>
                            <UniformGrid Columns="4">
                                <StackPanel Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="NAME" Classes="fieldLabel" />
                                    <TextBlock Text="{Binding DisplayName}" Classes="fieldValue"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="MOD ID" Classes="fieldLabel" />
                                    <TextBlock Text="{Binding ModId}" Classes="fieldValue"
                                               FontFamily="Consolas,Menlo,monospace" />
                                </StackPanel>
                                <StackPanel Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="SOURCE" Classes="fieldLabel" />
                                    <TextBlock Text="{Binding Source}" Classes="fieldValue" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="PATH" Classes="fieldLabel" />
                                    <TextBlock Text="{Binding FolderPath}" Classes="fieldValue"
                                               TextWrapping="Wrap"
                                               FontFamily="Consolas,Menlo,monospace"
                                               FontSize="11" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
