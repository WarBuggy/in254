<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Launcher.ViewModels"
        xmlns:controls="using:Launcher.Controls"
        x:Class="Launcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="in254 Mod Launcher"
        Width="780" Height="600"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Icon="avares://Launcher/Assets/Icon.ico"
        Background="#1A1A2E">

    <Window.Styles>
        <!-- Accent button class -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="20,8" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A8FE0" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#006ABD" />
        </Style>

        <!-- Secondary button class -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#2A2A40" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderBrush" Value="#3A3A55" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#363655" />
        </Style>

        <!-- Toolbar icon button -->
        <Style Selector="Button.toolBtn">
            <Setter Property="Background" Value="#2A2A40" />
            <Setter Property="Foreground" Value="#BBBBBB" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="#3A3A55" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.toolBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#363655" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Tab styling -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
        </Style>

        <!-- Stat card -->
        <Style Selector="Border.statCard">
            <Setter Property="Background" Value="#22223A" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="BorderBrush" Value="#2E2E48" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Detail card -->
        <Style Selector="Border.detailCard">
            <Setter Property="Background" Value="#22223A" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderBrush" Value="#2E2E48" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Muted label -->
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#888899" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Detail field label -->
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="Foreground" Value="#7788AA" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1" />
        </Style>

        <!-- Detail field value -->
        <Style Selector="TextBlock.fieldValue">
            <Setter Property="Foreground" Value="#DDDDEE" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- Section heading -->
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#EEEEFF" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- ===== HEADER ===== -->
        <Border DockPanel.Dock="Top"
                Background="#16162B"
                Padding="20,14"
                BorderBrush="#2A2A44"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="avares://Launcher/Assets/Icon.ico"
                       Width="28" Height="28"
                       VerticalAlignment="Center" />
                <TextBlock Text="in254"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#0078D4" />
                <TextBlock Text="Mod Launcher"
                           FontSize="20" FontWeight="Light"
                           Foreground="#AAAACC"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ===== FOOTER ===== -->
        <Border DockPanel.Dock="Bottom"
                Background="#16162B"
                Padding="20,12"
                BorderBrush="#2A2A44"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <Button Content="{Binding LaunchButtonText}"
                        Classes="accent"
                        Command="{Binding LaunchGameCommand}" />
                <StackPanel Orientation="Horizontal"
                            Spacing="16"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Classes="muted">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} mods">
                                <Binding Path="TotalModCount" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Foreground="#50C878" FontSize="12">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} enabled">
                                <Binding Path="EnabledModCount" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Foreground="#FF6B6B" FontSize="12">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} disabled">
                                <Binding Path="DisabledModCount" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== BODY ===== -->
        <TabControl Margin="0" Padding="16,8,16,16">

            <!-- ===== OVERVIEW TAB ===== -->
            <TabItem Header="Overview">
                <ScrollViewer Margin="0,12,0,0">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Dashboard" Classes="sectionTitle" />

                        <UniformGrid Columns="3" Margin="0,4,0,0">
                            <Border Classes="statCard" Margin="0,0,8,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Total Mods" Classes="muted" />
                                    <TextBlock Text="{Binding TotalModCount}"
                                               FontSize="28" FontWeight="Bold"
                                               Foreground="#0078D4" />
                                </StackPanel>
                            </Border>
                            <Border Classes="statCard" Margin="4,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Enabled" Classes="muted" />
                                    <TextBlock Text="{Binding EnabledModCount}"
                                               FontSize="28" FontWeight="Bold"
                                               Foreground="#50C878" />
                                </StackPanel>
                            </Border>
                            <Border Classes="statCard" Margin="8,0,0,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Disabled" Classes="muted" />
                                    <TextBlock Text="{Binding DisabledModCount}"
                                               FontSize="28" FontWeight="Bold"
                                               Foreground="#FF6B6B" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== MODS TAB ===== -->
            <TabItem Header="Mods">
                <DockPanel Margin="0,12,0,0">
                    <!-- Toolbar (spans full width) -->
                    <Border DockPanel.Dock="Top"
                            Background="#1E1E36"
                            CornerRadius="8"
                            Padding="8,6"
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Classes="toolBtn"
                                    Command="{Binding MoveUpCommand}"
                                    ToolTip.Tip="Move Up">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="&#x25B2;" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Text="Up" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="toolBtn"
                                    Command="{Binding MoveDownCommand}"
                                    ToolTip.Tip="Move Down">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="&#x25BC;" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Text="Down" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border Width="1" Background="#3A3A55" Margin="4,2" />
                            <Button Classes="toolBtn"
                                    Command="{Binding AutoReOrderCommand}"
                                    ToolTip.Tip="Automatically sort mods">
                                <TextBlock Text="Auto Sort" VerticalAlignment="Center" />
                            </Button>
                            <Border Width="1" Background="#3A3A55" Margin="4,2" />
                            <Button Classes="toolBtn"
                                    Command="{Binding AddModCommand}"
                                    ToolTip.Tip="Add a mod">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="+" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Text="Add" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="toolBtn"
                                    Command="{Binding DeleteModCommand}"
                                    ToolTip.Tip="Delete selected mod"
                                    Foreground="#FF6B6B">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="&#x2715;" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Text="Delete" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Content: List + Detail side by side -->
                    <Grid ColumnDefinitions="*,Auto,*">

                    <!-- Mod list -->
                    <Border Grid.Column="0"
                            CornerRadius="8"
                                Background="#1E1E36"
                                BorderBrush="#2E2E48"
                                BorderThickness="1"
                                ClipToBounds="True">
                            <controls:DragReorderListBox x:Name="ModListBox"
                                     ItemsSource="{Binding Mods}"
                                     SelectedItem="{Binding SelectedMod}"
                                     SelectionMode="Toggle"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <controls:DragReorderListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="10,6" />
                                        <Setter Property="Margin" Value="4,1" />
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#28284A" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#24243E" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#2A2A4A" />
                                    </Style>
                                    <!-- Show dot on selected -->
                                    <Style Selector="ListBoxItem Ellipse.selectDot">
                                        <Setter Property="IsVisible" Value="False" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected Ellipse.selectDot">
                                        <Setter Property="IsVisible" Value="True" />
                                    </Style>
                                    <Style Selector="ListBoxItem.dragSource">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </Style>
                                    <!-- Grip handle hover -->
                                    <Style Selector="ListBoxItem Border[Tag=GripHandle]:pointerover">
                                        <Setter Property="Background" Value="#2A2A4A" />
                                    </Style>
                                    <Style Selector="ListBoxItem Border[Tag=GripHandle]:pointerover Ellipse">
                                        <Setter Property="Fill" Value="#8888AA" />
                                    </Style>
                                </controls:DragReorderListBox.Styles>

                                <controls:DragReorderListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModEntryViewModel">
                                        <Panel>
                                            <Border x:Name="DropIndicator"
                                                    Height="2"
                                                    Background="#0078D4"
                                                    VerticalAlignment="Top"
                                                    Margin="-10,-6"
                                                    IsVisible="False" />
                                            <DockPanel>
                                                <!-- Grip handle: 2x3 dot grid -->
                                                <Border Tag="GripHandle"
                                                        DockPanel.Dock="Left"
                                                        Cursor="Hand"
                                                        Margin="2,0,10,0"
                                                        Padding="3,2"
                                                        CornerRadius="4"
                                                        Background="Transparent"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding !IsReserved}">
                                                    <Grid RowDefinitions="Auto,Auto,Auto"
                                                          ColumnDefinitions="Auto,Auto"
                                                          Tag="GripHandle">
                                                        <Ellipse Grid.Row="0" Grid.Column="0" Width="3" Height="3" Fill="#555570" Margin="1" />
                                                        <Ellipse Grid.Row="0" Grid.Column="1" Width="3" Height="3" Fill="#555570" Margin="1" />
                                                        <Ellipse Grid.Row="1" Grid.Column="0" Width="3" Height="3" Fill="#555570" Margin="1" />
                                                        <Ellipse Grid.Row="1" Grid.Column="1" Width="3" Height="3" Fill="#555570" Margin="1" />
                                                        <Ellipse Grid.Row="2" Grid.Column="0" Width="3" Height="3" Fill="#555570" Margin="1" />
                                                        <Ellipse Grid.Row="2" Grid.Column="1" Width="3" Height="3" Fill="#555570" Margin="1" />
                                                    </Grid>
                                                </Border>
                                                <Border Width="22"
                                                        DockPanel.Dock="Left"
                                                        IsVisible="{Binding IsReserved}" />

                                                <!-- Selection dot -->
                                                <Ellipse Classes="selectDot"
                                                         Width="6" Height="6"
                                                         Fill="#0078D4"
                                                         VerticalAlignment="Center"
                                                         DockPanel.Dock="Right"
                                                         Margin="8,0,0,0" />

                                                <!-- Source badge -->
                                                <Border DockPanel.Dock="Right"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Background="#2A2A40"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Source}"
                                                               FontSize="10"
                                                               Foreground="#888899" />
                                                </Border>

                                                <!-- Checkbox + name -->
                                                <CheckBox IsChecked="{Binding IsEnabled}"
                                                          IsEnabled="{Binding !IsReserved}"
                                                          VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               Foreground="#DDDDEE"
                                                               VerticalAlignment="Center" />
                                                </CheckBox>
                                            </DockPanel>
                                        </Panel>
                                    </DataTemplate>
                                </controls:DragReorderListBox.ItemTemplate>
                            </controls:DragReorderListBox>
                        </Border>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1"
                                  Width="6"
                                  Background="Transparent"
                                  ResizeBehavior="PreviousAndNext" />

                    <!-- Right: Detail Panel -->
                    <Border Grid.Column="2"
                            Classes="detailCard"
                            Margin="4,0,0,0"
                            IsVisible="{Binding IsDetailVisible}">
                        <ScrollViewer>
                            <StackPanel Spacing="16" DataContext="{Binding SelectedMod}">
                                <TextBlock Text="Mod Details" Classes="sectionTitle" />

                                <Border Background="#1A1A2E" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="10">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="NAME" Classes="fieldLabel" />
                                            <TextBlock Text="{Binding DisplayName}" Classes="fieldValue"
                                                       FontWeight="SemiBold" FontSize="15" />
                                        </StackPanel>

                                        <Border Height="1" Background="#2E2E48" Margin="0,2" />

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="MOD ID" Classes="fieldLabel" />
                                            <TextBlock Text="{Binding ModId}" Classes="fieldValue"
                                                       FontFamily="Consolas,Menlo,monospace" />
                                        </StackPanel>

                                        <Border Height="1" Background="#2E2E48" Margin="0,2" />

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="SOURCE" Classes="fieldLabel" />
                                            <TextBlock Text="{Binding Source}" Classes="fieldValue" />
                                        </StackPanel>

                                        <Border Height="1" Background="#2E2E48" Margin="0,2" />

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="PATH" Classes="fieldLabel" />
                                            <TextBlock Text="{Binding FolderPath}" Classes="fieldValue"
                                                       TextWrapping="Wrap"
                                                       FontFamily="Consolas,Menlo,monospace"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
