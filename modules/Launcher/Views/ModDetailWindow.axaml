<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Launcher.ViewModels"
        x:Class="Launcher.Views.ModDetailWindow"
        x:DataType="vm:ModDetailViewModel"
        Title="Mod Details"
        Width="700" Height="620"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E"
        CanResize="True">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#7788AA" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="#DDDDEE" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="Border.section">
            <Setter Property="Background" Value="#22223A" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderBrush" Value="#2E2E48" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.closeBtn">
            <Setter Property="Background" Value="#2A2A40" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="BorderBrush" Value="#3A3A55" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.closeBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#363655" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom"
                Background="#16162B"
                Padding="16,12"
                BorderBrush="#2A2A44"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Classes="closeBtn" Content="Close" Click="OnClose" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Mod.Source}" Foreground="#888899" FontSize="11" />
                    <TextBlock Text="·" Foreground="#555570" />
                    <TextBlock Text="{Binding Mod.FolderPath}" Foreground="#666680" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Padding="20">
            <StackPanel Spacing="16">

                <!-- Header: Preview + Title -->
                <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0"
                            Width="120" Height="120"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Background="#2A2A40"
                            Margin="0,0,16,0">
                        <Panel>
                            <Image Source="{Binding PreviewImage}"
                                   Stretch="UniformToFill"
                                   IsVisible="{Binding HasPreview}" />
                            <TextBlock Text="&#x2B22;"
                                       FontSize="48"
                                       Foreground="#555570"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !HasPreview}" />
                        </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="{Binding Mod.DisplayName}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="#EEEEFF" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding VersionDisplay}"
                                       Foreground="#888899" FontSize="13" />
                            <TextBlock Text="·" Foreground="#555570" FontSize="13" />
                            <TextBlock Text="{Binding AuthorDisplay}"
                                       Foreground="#888899" FontSize="13" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                            <ItemsControl ItemsSource="{Binding Info.Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,3"
                                                Background="#2A2A40" BorderBrush="#3A3A55" BorderThickness="1">
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="#8899BB" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Description -->
                <Border Classes="section">
                    <StackPanel Spacing="6">
                        <TextBlock Text="DESCRIPTION" Classes="label" />
                        <TextBlock Text="{Binding DescriptionDisplay}" Classes="value"
                                   TextWrapping="Wrap" LineHeight="20" />
                    </StackPanel>
                </Border>

                <!-- Info Grid -->
                <Border Classes="section">
                    <UniformGrid Columns="3">
                        <StackPanel Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="MOD ID" Classes="label" />
                            <TextBlock Text="{Binding Mod.ModId}" Classes="value"
                                       FontFamily="Consolas,Menlo,monospace" />
                        </StackPanel>
                        <StackPanel Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="GAME VERSION" Classes="label" />
                            <TextBlock Text="{Binding GameVersionDisplay}" Classes="value" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="DEPENDENCIES" Classes="label" />
                            <TextBlock Text="{Binding DependenciesDisplay}" Classes="value" />
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <!-- Workshop -->
                <Border Classes="section">
                    <StackPanel Spacing="2">
                        <TextBlock Text="STEAM WORKSHOP" Classes="label" />
                        <TextBlock Text="{Binding WorkshopIdDisplay}" Classes="value" />
                    </StackPanel>
                </Border>

                <!-- Screenshots -->
                <Border Classes="section" IsVisible="{Binding HasScreenshots}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="SCREENSHOTS" Classes="label" />
                        <ItemsControl ItemsSource="{Binding Screenshots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" ClipToBounds="True"
                                            Background="#1A1A2E" MaxHeight="300">
                                        <Image Source="{Binding}" Stretch="Uniform" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
