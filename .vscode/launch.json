{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (Console) Dev",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build Dev",
      "program": "${workspaceFolder}/bin/Dev/net10.0/in254.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "-debug",
      ],
    },
    {
      "name": ".NET Core Launch (Console) Release",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build Release",
      "program": "${workspaceFolder}/bin/Release/net10.0/in254.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "-debug",
      ],
    }
  ]
}